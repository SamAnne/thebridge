generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  roleId    Int
  county    String?
  createdAt DateTime   @default(now())
  district  String?
  name      String?
  active    Boolean    @default(true)
  verified  Boolean    @default(false)
  resourses Resource[]
  role      Role       @relation(fields: [roleId], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  role  String @unique
  users User[]
}

model Resource {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        DateTime @default(now())
  status      String
  note        String
  description String
  counties    String[] @default([])
  districts   String[] @default([])
  published   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  files       File[]
  user        User     @relation(fields: [userId], references: [id])
}

// Singleton row (always id=1) holding hub-wide configuration. Kept
// intentionally small for the MVP - just the four fields the admin
// settings panel needs.
model Settings {
  id                   Int     @id @default(1)
  hubName              String  @default("The Bridge")
  contactEmail         String  @default("")
  defaultCounty        String?
  acceptingSubmissions Boolean @default(true)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  location    String?
  link        String?
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model File {
  id         Int      @id @default(autoincrement())
  url        String
  fileName   String
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Domains {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  district  String
  county    String
}
