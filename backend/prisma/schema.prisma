// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// add district
// get all of them and make another table
// add district of user based on their email domain
model User {
  id        Int @id @default(autoincrement())
  email     String @unique
  password  String
  roleId    Int
  role      Role @relation(fields: [roleId], references: [id])
  resourses Resource[]
}

model Role {
  id        Int @id @default(autoincrement())
  role      String @unique
  users     User[]
}

model Resource {
  id        Int @id @default(autoincrement())
  userId    Int
  user      User @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  status    String  // rejected, approved, revision, unseen
  description  String
  files     File[]
  // county?/district
  note      String
}

model File {
  id         Int      @id @default(autoincrement())
  url        String
  fileName   String
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id])
}



